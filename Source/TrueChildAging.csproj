<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10</LangVersion>

    <ProjectGuid>{B415CF55-634E-4A79-BFFD-17B7B73C0A71}</ProjectGuid>
    <RootNamespace>TrueChildAging</RootNamespace>
    <AssemblyName>TrueChildAging</AssemblyName>

    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Embed the portable PDB inside the DLL so symbols ship in a single file
         (no separate .pdb next to the assembly). -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Only dependency is the reference-assemblies package; skip NuGet's
         vulnerability audit so restore works on read-only caches (NU1900). -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release v1.2' ">
    <RimWorldVersion>1.2</RimWorldVersion>
    <RimWorldInstall>/rimworld/1.2</RimWorldInstall>
    <DefineConstants>RIMWORLD12</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release v1.3' ">
    <RimWorldVersion>1.3</RimWorldVersion>
    <RimWorldInstall>/rimworld/1.3</RimWorldInstall>
    <DefineConstants>RIMWORLD13</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release v1.4' ">
    <RimWorldVersion>1.4</RimWorldVersion>
    <RimWorldInstall>/rimworld/1.4</RimWorldInstall>
    <DefineConstants>RIMWORLD14</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release v1.5' ">
    <RimWorldVersion>1.5</RimWorldVersion>
    <RimWorldInstall>/rimworld/1.5</RimWorldInstall>
    <DefineConstants>RIMWORLD15</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release v1.6' ">
    <RimWorldVersion>1.6</RimWorldVersion>
    <RimWorldInstall>/rimworld/1.6-steam</RimWorldInstall>
    <DefineConstants>RIMWORLD16</DefineConstants>
  </PropertyGroup>

  <Target Name="FailOnUnsupportedConfiguration" BeforeTargets="BeforeBuild" Condition=" '$(RimWorldVersion)' == '' ">
    <Error Text="Unsupported configuration '$(Configuration)'. Use one of: Release v1.2, Release v1.3, Release v1.4, Release v1.5, Release v1.6" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition=" '$(RimWorldVersion)' != '' ">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldInstall)/RimWorldLinux_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldInstall)/RimWorldLinux_Data/Managed/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldInstall)/RimWorldLinux_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldInstall)/RimWorldLinux_Data/Managed/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldInstall)/RimWorldLinux_Data/Managed/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(RimWorldInstall)/Mods/Harmony/Current/Assemblies/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
